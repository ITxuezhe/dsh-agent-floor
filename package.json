{
  "name": "dsh-agent-floor",
  "version": "0.2.0",
  "description": "Agent Floor — a compact always-on dock for DeepSeek Harness: which session is running, how far along, how many tokens, which files changed.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agents",
    "dashboard",
    "observability"
  ],
  "homepage": "https://github.com/ITxuezhe/dsh-agent-floor",
  "repository": {
    "type": "git",
    "url": "https://github.com/ITxuezhe/dsh-agent-floor.git"
  },
  "engines": {
    "dsh": "^0.2.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "scripts/harness.js",
    "scripts/README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
